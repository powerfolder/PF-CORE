<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        False positive: CVE-2026-0994 is a bug in the Python protobuf package
        (recursion limit bypass in the pure-Python JSON parser). It does not
        exist in protobuf-java. The scanner flags protobuf-java 4.36.2 because
        the advisory lists a single unified fix version (33.4) and the Java
        artifact uses the 4.x.y scheme, so the version comparison cannot
        exclude it. 4.36.2 is past the fixed minor (36 > 33) either way.
    -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-0994 affects the Python protobuf package only. protobuf-java
            4.36.2 is not affected and is past the unified fix version 33.4.
        ]]></notes>
        <!-- INT-1774 review: pin to the exact shipped jar so a future protobuf-java
             bump/downgrade is re-evaluated instead of silently inheriting this exemption. -->
        <filePath regex="true">.*[/\\]protobuf-java-4\.36\.2\.jar$</filePath>
        <cve>CVE-2026-0994</cve>
    </suppress>

    <!--
        False positive: commons-cli-1.0.jar is Apache Commons CLI (org.apache.commons.cli,
        command line argument parsing). dependency-check matches it against the CPE of the
        unrelated Apache Commons Net library, which carries CVE-2021-37533 (the FTP client
        follows the host in a PASV reply). commons-cli ships no org.apache.commons.net code
        and no FTP client at all, so the CVE cannot apply. Confidence of the match is "Low".
        The match is not in the report of 2026-10-10 any more; the rule stays as a guard in
        case the CPE comes back. Only the wrong product CPE is suppressed - a real Commons
        CLI advisory still reports.
    -->
    <suppress>
        <notes><![CDATA[
            commons-cli incorrectly matched against the unrelated commons-net library.
            False positive, verified against the jar contents (org/apache/commons/cli only).
        ]]></notes>
        <filePath regex="true">.*[/\\]commons-cli-[0-9.]+\.jar$</filePath>
        <cpe>cpe:/a:apache:commons_net</cpe>
    </suppress>

</suppressions>
